{
  "manifest_version": 3,
  "name": "AIQuota 触控栏歌词",
  "description": "把 B 站 / YouTube 正在播放的歌词或字幕送到 Mac 触控栏（AIQuota）。只在这两个网站上运行。",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://lrclib.net/*", "https://music.163.com/*", "https://lyrics.kugou.com/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/*", "https://www.bilibili.com/festival/*",
                  "https://www.youtube.com/*"],
      "js": ["main.js"], "world": "MAIN", "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/*", "https://www.bilibili.com/festival/*",
                  "https://www.youtube.com/*"],
      "js": ["lib/lrc.js", "lib/json3.js", "content.js"], "css": ["hide-cc.css"], "run_at": "document_start"
    }
  ]
}
